# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Raw training datasets: large, re-downloadable, not needed to run the app
# (only to retrain). The trained *.joblib bundles themselves ARE committed
# (see models/ below) so a fresh clone deploys without any training step.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*.pkl

# Reports (generated)
reports/*.pdf
!reports/.gitkeep

# Env / secrets
.env
*.db
*.sqlite3

# OS / editor
.DS_Store
.vscode/
.idea/
